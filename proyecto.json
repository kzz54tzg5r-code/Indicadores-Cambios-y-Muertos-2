
from pathlib import Path
import streamlit as st
from core.styles import apply_styles, header, section
from core.auth import require_login
from core.storage import ACTIVE_FILE, save_uploaded_file, get_metadata, delete_active_file, load_project, load_goals
from core.loader import load_excel
from core.ui import nav, panel
from pages_app import pages

st.set_page_config(page_title="Indicadores Cambios y Muertos", page_icon="📊", layout="wide")
apply_styles()
user = require_login()

st.sidebar.divider()
st.sidebar.markdown("## 📁 Archivo")
meta=get_metadata()
if ACTIVE_FILE.exists():
    st.sidebar.success("Archivo cargado")
    st.sidebar.caption(meta.get("archivo",""))
else:
    st.sidebar.warning("Sin archivo")

if user.get("permiso")=="Administrador":
    up=st.sidebar.file_uploader("Cargar Excel", type=["xlsx"])
    if up and st.sidebar.button("Procesar archivo"):
        save_uploaded_file(up); st.cache_data.clear(); st.rerun()
    if ACTIVE_FILE.exists() and st.sidebar.button("Borrar archivo"):
        delete_active_file(); st.cache_data.clear(); st.rerun()

header(user)

if not ACTIVE_FILE.exists():
    st.warning("Carga el archivo Excel desde el panel lateral.")
    st.stop()

@st.cache_data(show_spinner=False)
def cached_load(path, mtime):
    return load_excel(path)

op, co, diag, nombre_map = cached_load(str(ACTIVE_FILE), ACTIVE_FILE.stat().st_mtime)

project = load_project()
metas = load_goals()
items = project.get("pestanas", ["Dashboard","Por Día","Reporte Semanal","Reporte Mensual","Conversión","Recuperación Económica","Productividad","Recorridos","Rankings","Macro","Diagnóstico","Configuración","Usuarios"])
page = nav(items)
ctx = {"op":op, "co":co, "diag":diag, "nombre_map":nombre_map, "tiendas":project.get("tiendas_proyecto",[]), "metas":metas, "user":user}

if page=="Dashboard": pages.dashboard(ctx)
elif page=="Por Día": pages.por_dia(ctx)
elif page=="Reporte Semanal": pages.semanal(ctx)
elif page=="Reporte Mensual": pages.mensual(ctx)
elif page=="Conversión": pages.conversion_page(ctx)
elif page=="Recuperación Económica": pages.recuperacion(ctx)
elif page=="Productividad": pages.productividad_page(ctx)
elif page=="Recorridos": pages.simple_table(ctx, "Recorridos", op)
elif page=="Rankings": pages.simple_table(ctx, "Rankings", op)
elif page=="Macro": pages.simple_table(ctx, "Macro", op)
elif page=="Diagnóstico": pages.simple_table(ctx, "Diagnóstico", diag)
elif page=="Configuración": pages.configuracion(ctx)
elif page=="Usuarios": pages.usuarios(ctx)

st.markdown("---")
st.caption("CONFIDENCIAL | Price Shoes | Operaciones Ropa")
